#!/usr/bin/env bash
# Offline test suite: runs aws-find against tests/fake-aws in a throwaway
# HOME with a canned SSO token, and asserts on the output. No AWS access
# needed. Usage: tests/run
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd); root=$(dirname "$here")
H=$(mktemp -d); trap 'rm -rf "$H"' EXIT
mkdir -p "$H/.aws/sso/cache" "$H/bin"
printf '[sso-session acme]\nsso_start_url = https://acme.awsapps.com/start\nsso_region = ap-southeast-2\n' >"$H/.aws/config"
printf '{"startUrl":"https://acme.awsapps.com/start","accessToken":"tok","expiresAt":"2099-01-01T00:00:00Z"}' >"$H/.aws/sso/cache/a.json"
cp "$here/fake-aws" "$H/bin/aws"; chmod +x "$H/bin/aws"
# fzf stub: cancels the picker (exit 130) so runs never block on a terminal
printf '#!/usr/bin/env bash\ncat >/dev/null; exit 130\n' >"$H/bin/fzf"; chmod +x "$H/bin/fzf"
# dig stub: fixed answer so tests are hermetic
cat >"$H/bin/dig" <<'DIG'
#!/usr/bin/env bash
# args: +short [TYPE] name. NS answers define the public zone apexes.
case " $* " in
  *" NS example.com "*)        printf 'ns-2.awsdns-02.co.uk.\nns-1.awsdns-01.org.\n' ;;
  *" NS example.app "*)        printf 'ns-5.awsdns-05.com.\nns-6.awsdns-06.net.\n' ;;
  *" NS cus-1.example.app "*)  printf 'ns-9.awsdns-09.net.\nns-10.awsdns-10.org.\n' ;;
  *" NS elsewhere.example "*)  printf 'dana.ns.cloudflare.com.\n' ;;
  *" NS "*)                    ;;
  *)                           echo 203.0.113.10 ;;
esac
DIG
chmod +x "$H/bin/dig"
# keep the ip-ranges lookup offline: an empty cache file is treated as "unknown"
mkdir -p "$H/.cache/aws-find"; : >"$H/.cache/aws-find/ip-ranges.json"

pass=0; fail=0
export AWS_FIND_GROUPS='web=Web *;shared=Shared Services;both=web*,shared*;empty=nothing-here'
run() { HOME=$H TMPDIR=$H PATH="$H/bin:$PATH" AWS_FIND_REGIONS="${AWS_FIND_REGIONS-ap-southeast-2 us-east-1}" AWS_FIND_PARALLEL=4 \
        timeout 60 "$root/aws-find" "$@" </dev/null 2>&1; echo "exit=$?"; }
check() {  # check <name> <expected-substring> <command...>
  local name="$1" want="$2"; shift 2
  local out; out=$(run "$@")
  if grep -qF -- "$want" <<<"$out"; then pass=$((pass+1)); printf '  ok   %s\n' "$name"
  else fail=$((fail+1)); printf '  FAIL %s\n       wanted: %s\n' "$name" "$want"; sed 's/^/       | /' <<<"$out"; fi
}
check "host: IP match found in the right account"   "app-web-01 (i-0123456789abcdef0) is in account Web Production [123456789012]" host app.example.com
check "host: tag match reported separately"         "name/tag match only" host app.example.com
check "host: picker cancel exits 0"                 "exit=0" host app.example.com
check "host: --no-name suppresses tag search"       "exit=0" host app.example.com --no-name
check "dns: live zone marked authoritative"        "zone example.com in account Web Production [123456789012] — AUTHORITATIVE" dns app.example.com
check "dns: exact record shown"                     "app.example.com → A 203.0.113.10" dns app.example.com
check "dns: private zone flagged"                   "example.com (private) in account Shared Services" dns app.example.com
check "dns: scheme and path stripped"               "Public DNS view of portal.cus-1.example.app" dns 'https://portal.cus-1.example.app/login'
check "dns: delegated child is the apex"            "zone apex   : cus-1.example.app" dns https://portal.cus-1.example.app/login
check "dns: child zone authoritative"               "zone cus-1.example.app in account Shared Services [210987654321] — AUTHORITATIVE" dns portal.cus-1.example.app
check "dns: wildcard record found"                  "*.cus-1.example.app → CNAME lb.cus-1.example.app" dns portal.cus-1.example.app
check "dns: parent shows delegation"                "parent zone: delegates cus-1.example.app to ns-10.awsdns-10.org ns-9.awsdns-09.net" dns portal.cus-1.example.app
check "dns: non-Route53 provider warned"            "provider    : Cloudflare" dns x.elsewhere.example
check "dns: host kind also strips scheme"           "Resolving app.example.com" host https://app.example.com/
check "ec2: match by Name tag"                     "app-web-01 (i-0123456789abcdef0) in account Web Production" ec2 'app-web'
check "ec2: match by private IP"                    "App-staging (i-0fedcba987654321f)" ec2 10.1.0.9
check "ec2: match by other tag value"               "app-web-01" ec2 prod
check "ec2: bare * lists all"                       "App-staging" ec2 '*'
check "json: rows carry console url"                '"url":"https://acme.awsapps.com/start/#/console?account_id=123456789012&role_name=AWSPowerUserAccess&destination=' ec2 app-web --json
check "json: rows carry role"                       '"role":"AWSReadOnlyAccess"' sg website --json
check "regions: --regions all asks each account"   "regions [all enabled, per account]" sg website --regions all
check "regions: all scans opt-in region"            "Web Production                       eu-west-1" sg website --regions all
check "regions: --regions='*' accepted"             "regions [all enabled, per account]" sg website "--regions=*"
AWS_FIND_REGIONS=all check "regions: env all"       "regions [all enabled, per account]" sg website
AWS_FIND_REGIONS='' AWS_DEFAULT_REGION=us-east-1 check "regions: AWS_DEFAULT_REGION honoured" "regions [us-east-1]" lambda billing
AWS_FIND_REGIONS='' AWS_REGION=us-east-1 check "regions: AWS_REGION honoured" "lambda billing-thumbnailer" lambda billing
check "regions: global kinds still once per account" "s3 acme-prod-logs in account Web Production" s3 acme --regions all
check "ec2: --running keeps running only"          "app-web-01" ec2 '*' --running
out=$(run ec2 '*' --running); if grep -q 'App-staging' <<<"$out"; then fail=$((fail+1)); echo "  FAIL ec2: --running leaked a stopped instance"; else pass=$((pass+1)); echo "  ok   ec2: --running excludes stopped"; fi
check "ec2: --state stopped"                        "App-staging" ec2 '*' --state stopped
check "ec2: --state is server-side filter"          "Name=instance-state-name,Values=running" ec2 '*' --running --show-commands
check "ec2: --state warned for other kinds"         "--state only affects 'ec2'" sg website --running
check "accounts: group selects"                    "Accounts (web): Web Production" sg website --accounts web
out=$(run sg website --accounts web); if grep -q 'Shared Services' <<<"$out"; then fail=$((fail+1)); echo "  FAIL accounts: group leaked other account"; else pass=$((pass+1)); echo "  ok   accounts: group excludes others"; fi
check "accounts: ad-hoc glob"                       "Accounts (shared*): Shared Services" sg website --accounts 'shared*'
check "accounts: account id"                        "Accounts (210987654321): Shared Services" sg website --accounts=210987654321
check "accounts: comma list and multi-pattern group" "Accounts (both): Shared Services, Web Production" sg website --accounts both
AWS_FIND_ACCOUNTS=web check "accounts: env default"   "Accounts (web): Web Production" sg website
check "accounts: no match dies"                     "matched no account" sg website --accounts empty
check "groups: lists members"                       "Web Production                         123456789012" groups
check "groups: empty group flagged"                 "(matches no account)" groups
check "s3: name glob"                               "s3 acme-prod-logs in account Web Production" s3 'acme-*'
check "s3: region resolved per bucket"              "region ap-southeast-2" s3 acme-prod-logs
check "s3: --tags finds CamelCase stack via separators" "DigitalAssetStack" s3 digital-asset --tags
check "s3: no match exits 2"                        "exit=2" s3 nothing-here
check "sg: matched by description"                  "sg website-web" sg 'website web'
check "sg: bare * lists everything (default group)" "default" sg '*'
check "pl: match by name"                           "pl office-ips in account Shared Services" pl office
check "lambda: anchored glob"                       "lambda billing-thumbnailer" lambda 'billing-*'
jsonout=$(HOME=$H TMPDIR=$H PATH="$H/bin:$PATH" AWS_FIND_REGIONS="ap-southeast-2" AWS_FIND_PARALLEL=4 timeout 60 "$root/aws-find" sg website --json --show-commands </dev/null 2>/dev/null)
if jq -e . >/dev/null 2>&1 <<<"$jsonout"; then pass=$((pass+1)); echo "  ok   show-commands: --json stdout stays pure JSON"; else fail=$((fail+1)); echo "  FAIL show-commands: --json stdout polluted"; sed 's/^/       | /' <<<"$jsonout"; fi
check "json: rows on stdout"                        '"kind":"lambda"' lambda billing --json
check "roles: most capable role chosen"             "AWSPowerUserAccess" roles
check "roles: chosen role is marked"                "(will be used)" roles
check "show-commands: report printed"            "Commands used" sg website --show-commands
check "show-commands: SSO token redacted"         "--access-token <redacted>" sg website --show-commands
check "show-commands: grouped across accounts"    "ran in 2 account(s), region(s): ap-southeast-2 us-east-1" sg website --show-commands
check "show-commands: explained"                  "# all security groups in the region" sg website --show-commands
check "show-commands: pasteable quoting"          "--query 'SecurityGroups[]" sg website --show-commands
check "show-commands: works with roles"           "# permission sets you hold" roles --show-commands
check "version flag"                                "aws-find 0.5.0" --version
check "bad kind refused"                            "unknown kind" bogus x
FAKE_DENY_EC2=1 check "denied account is reported with its role" "(as AWSPowerUserAccess) ap-southeast-2: An error occurred (UnauthorizedOperation)" host app.example.com
FAKE_DENY_EC2=1 check "denied scan still finishes"  "scan(s) reported errors" sg website

out=$(run sg website --show-commands --json)
if grep -q -- '--access-token tok' <<<"$out"; then fail=$((fail+1)); echo "  FAIL show-commands: raw SSO token leaked"; else pass=$((pass+1)); echo "  ok   show-commands: raw SSO token never printed"; fi
printf '\n%d passed, %d failed\n' "$pass" "$fail"; [[ $fail -eq 0 ]]
