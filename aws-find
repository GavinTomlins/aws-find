#!/usr/bin/env bash
# aws-find — search every account in an AWS Organization (via IAM Identity
# Center) for a resource, then jump to it in the console.
#
#   aws-find host   <dns-name>      which account/region hosts this hostname?
#   aws-find ec2    <glob>          EC2 instances by Name tag, instance id, IP or any tag value
#   aws-find s3     <glob>          S3 buckets whose name matches
#   aws-find sg     <glob>          security groups by id, name, description or tag
#   aws-find pl     <glob>          managed prefix lists by id, name or tag
#   aws-find lambda <glob>          Lambda functions by name
#   aws-find dns    <dns-name>      which account holds the Route 53 zone and record, and is it live?
#   aws-find roles                  list the permission sets you hold in each account
#
# Globs are case-insensitive and support * and ?. A pattern without a
# wildcard is treated as *pattern*. Hyphen, underscore and space in a pattern
# are optional separators, so digital-asset also matches DigitalAssetStack.
#
# Examples
#   aws-find host app.example.com
#   aws-find host --name website app.example.com               # also match tag values *website*
#   aws-find dns app.example.com                               # zone, record, and whether Route 53 is authoritative
#   aws-find dns https://portal.cus-1.example.app/login        # scheme and path are stripped; finds delegated child zones
#   aws-find ec2 'web-*'                                       # instances by Name tag across the org
#   aws-find ec2 '*' --json | tv                               # browse every instance in television
#   aws-find s3 backup                                         # any bucket containing "backup"
#   aws-find s3 'acme-*-logs'                                  # anchored glob
#   aws-find s3 digital-asset --tags                           # also match bucket tags, e.g. the CDK/CFN
#                                                              #   stack name or logical id (slower)
#   aws-find sg 'sg-0a1b*'                                     # by group id prefix
#   aws-find sg website --regions "ap-southeast-2"             # by name/description/tag, one region
#   aws-find pl office                                         # prefix lists named *office*
#   aws-find lambda 'billing-*' --accounts pick                # fzf-select which accounts to scan
#   aws-find lambda thumbnail --json | jq .                    # machine-readable, no picker
#   aws-find sg website --show-commands                        # print every aws command used, grouped
#                                                              #   and explained, to learn the CLI
#   aws-find host app.example.com --role ReadOnlyAccess --debug
#   aws-find roles                                             # which role will be used where?
#
# Common flags
#   -v, --version       print the aws-find version and exit
#   --regions "r1 r2"   regions to scan            (default: $AWS_FIND_REGIONS or ap-southeast-2 us-east-1)
#   --accounts pick     fzf multi-select accounts  (default: all visible)
#   --role NAME         permission set to assume   (default: $AWS_FIND_ROLE, else the first of
#                       (AWS)AdministratorAccess, (AWS)PowerUserAccess, (AWS)ReadOnlyAccess,
#                       ViewOnlyAccess you hold)
#   --parallel N        concurrent workers         (default: 8)
#   --json              print result rows as JSON lines to stdout; no picker
#   --show-commands     after the scan, list every aws CLI command that ran (tokens redacted),
#                       grouped across accounts and explained; pasteable
#   --debug             show every AWS error and write an xtrace file
#
# s3-only flags
#   --tags                   also match bucket tag values; shows the CloudFormation stack name as label
#
# host-only flags
#   --name PAT | --no-name   tag/name pattern (default: first DNS label)
#   --fast                   one query via the Config aggregator (needs AWS_FIND_AGG_PROFILE)
#
# Environment: AWS_FIND_SSO_SESSION (the [sso-session NAME] block in ~/.aws/config to
#              use; optional when the file has exactly one), AWS_FIND_ROLE, AWS_FIND_REGIONS,
#              AWS_FIND_PARALLEL, AWS_FIND_AGG_PROFILE, AWS_FIND_AGG_NAME

VERSION="0.3.0"

set -euo pipefail
# shellcheck disable=SC2154
trap 'rc=$?; printf "\033[1;31mx\033[0m internal error (exit %s) at line %s: %s\n" "$rc" "$LINENO" "$BASH_COMMAND" >&2' ERR

SSO_SESSION="${AWS_FIND_SSO_SESSION:-}"
ROLE_PREF="${AWS_FIND_ROLE:-}"
REGIONS="${AWS_FIND_REGIONS:-ap-southeast-2 us-east-1}"
PARALLEL="${AWS_FIND_PARALLEL:-8}"
AGG_PROFILE="${AWS_FIND_AGG_PROFILE:-}"
AGG_NAME="${AWS_FIND_AGG_NAME:-aws-controltower-GuardrailsComplianceAggregator}"
MODE="fanout"; ACCOUNT_MODE="all"; DEBUG=0; JSON=0; S3_TAGS=0; SHOW_CMDS=0; NAME_PAT=""; KIND=""; PATTERN=""

log()  { printf '\033[1;34m»\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --show-commands: every aws call passes through here. When enabled, the
# command line is appended to a per-process log (the SSO token redacted, each
# argument shell-quoted so the line is pasteable) before the real CLI runs.
aws() {
  if [[ "${AWS_FIND_SHOW_CMDS:-0}" == 1 && -n "${AWS_FIND_CMDLOG:-}" ]]; then
    local line="aws" a redact=0
    for a in "$@"; do
      if [[ $redact == 1 ]]; then line+=" <redacted>"; redact=0; continue; fi
      [[ "$a" == "--access-token" ]] && redact=1
      if [[ "$a" =~ ^[A-Za-z0-9_./:=,@+-]+$ ]]; then line+=" $a"; else line+=" '${a//\'/\'\\\'\'}'"; fi
    done
    printf '%s\t%s\t%s\n' "${CMD_CTX:-${W_NAME:-main}}" "${W_REGION:-${AWS_DEFAULT_REGION:--}}" "$line" >>"$AWS_FIND_CMDLOG"
  fi
  command aws "$@"
}

# Console destination for a result row, and the Identity Center deep link
# that lands on it in the right account and role.
console_dest() {   # kind region id
  local k="$1" r="$2" id="$3"
  case "$k" in
    ec2)       echo "https://${r}.console.aws.amazon.com/ec2/home?region=${r}#InstanceDetails:instanceId=${id}" ;;
    eni)       echo "https://${r}.console.aws.amazon.com/ec2/home?region=${r}#NetworkInterface:networkInterfaceId=${id}" ;;
    eip)       echo "https://${r}.console.aws.amazon.com/ec2/home?region=${r}#Addresses:" ;;
    elb)       echo "https://${r}.console.aws.amazon.com/ec2/home?region=${r}#LoadBalancers:" ;;
    lightsail) echo "https://lightsail.aws.amazon.com/ls/webapp/${r}/instances/${id}/connect" ;;
    dns|route53) echo "https://us-east-1.console.aws.amazon.com/route53/v2/hostedzones#ListRecordSets/${id##*/}" ;;
    s3)        echo "https://s3.console.aws.amazon.com/s3/buckets/${id}?region=${r}&tab=objects" ;;
    sg)        echo "https://${r}.console.aws.amazon.com/ec2/home?region=${r}#SecurityGroup:groupId=${id}" ;;
    pl)        echo "https://${r}.console.aws.amazon.com/vpcconsole/home?region=${r}#PrefixListDetails:PrefixListId=${id}" ;;
    lambda)    echo "https://${r}.console.aws.amazon.com/lambda/home?region=${r}#/functions/${id}" ;;
    *)         echo "https://console.aws.amazon.com/" ;;
  esac
}
console_url() {   # account role dest
  [[ -n "${START_URL:-}" ]] || START_URL=$(awk -v s="[sso-session ${SSO_SESSION}]" '$0==s{f=1;next} /^\[/{f=0} f&&/sso_start_url/{print $3}' ~/.aws/config)
  [[ -n "$START_URL" ]] || die "cannot build a console link: sso_start_url not found for sso-session '${SSO_SESSION}'"
  echo "${START_URL}/#/console?account_id=${1}&role_name=${2}&destination=$(urlencode "$3")"
}

# One line of plain English per command, for the --show-commands report.
explain_cmd() {
  case "$1" in
    *"sso list-accounts"*)                     echo "accounts you can reach through IAM Identity Center" ;;
    *"sso list-account-roles"*)                echo "permission sets you hold in that account" ;;
    *"sso get-role-credentials"*)              echo "mint short-lived credentials for one account and role (these become AWS_ACCESS_KEY_ID etc. for the calls below)" ;;
    *"describe-network-interfaces"*)           echo "the network interface that owns the IP, whatever it is attached to (EC2, ELB node, NAT, RDS, Lambda)" ;;
    *"describe-instances --instance-ids"*)     echo "details of the instance attached to a matched interface or load balancer target" ;;
    *"describe-instances --filters"*)          echo "instances where any tag value matches the pattern" ;;
    *"ec2 describe-instances --query"*)        echo "all instances in the region; matched client-side on Name tag, id, IPs and tags" ;;
    *"describe-addresses"*)                    echo "Elastic IPs matching the address (an unattached one still shows up here)" ;;
    *"lightsail get-instances"*)               echo "Lightsail instances, which never appear as EC2 network interfaces" ;;
    *"elbv2 describe-load-balancers"*)         echo "the application/network load balancer whose DNS name the CNAME points at" ;;
    *"describe-target-groups"*)                echo "target groups behind that load balancer" ;;
    *"describe-target-health"*)                echo "instances registered in the target group" ;;
    *"elb describe-load-balancers"*)           echo "classic load balancers matching the CNAME" ;;
    *"route53 list-hosted-zones"*)             echo "hosted zones in the account, to find one that is a suffix of the name" ;;
    *"route53 get-hosted-zone"*)               echo "the zone's delegation set (its nameservers), to compare with the public NS records" ;;
    *"--start-record-type NS"*)                echo "an NS record at the child name: does this parent zone delegate it?" ;;
    *"route53 list-resource-record-sets"*)     echo "the record for the name inside that zone (exact name, then wildcards)" ;;
    *"s3api list-buckets"*)                    echo "every bucket in the account (S3 is global, so this runs once per account)" ;;
    *"s3api get-bucket-location"*)             echo "which region a matched bucket lives in" ;;
    *"s3api get-bucket-tagging"*)              echo "bucket tags; CloudFormation/CDK put the stack name and logical id here" ;;
    *"describe-security-groups"*)              echo "all security groups in the region; matched client-side on id, name, description and tags" ;;
    *"describe-managed-prefix-lists"*)         echo "all managed prefix lists in the region; matched client-side" ;;
    *"lambda list-functions"*)                 echo "all functions in the region; matched client-side on name" ;;
    *"select-aggregate-resource-config"*)      echo "one SQL query across the whole organization via the Config aggregator" ;;
    *)                                         echo "" ;;
  esac
}

# Group identical commands across accounts/regions and print them in first-seen
# order with the explanation, how many accounts and which regions ran them.
print_commands() {
  local files=("$TMP"/cmds-main.log "$TMP"/cmds-*-*.log) any=0
  for f in "${files[@]}"; do [[ -s "$f" ]] && any=1; done
  [[ $any -eq 1 ]] || return 0
  echo >&2
  printf '\033[1;34m»\033[0m \033[1mCommands used\033[0m (identical commands across accounts shown once; SSO token redacted)\n' >&2
  printf '  Each ran with that account'"'"'s credentials in the environment; reproduce with\n  \033[2maws sso login --sso-session %s && aws --profile <account-profile> ...\033[0m\n' "${SSO_SESSION:-<name>}" >&2
  cat "${files[@]}" 2>/dev/null | awk -F'\t' '
    { key=$3; sub(/--account-id [0-9]{12}/, "--account-id <account-id>", key)
      if (!(key in seen)) { seen[key]=1; order[++n]=key }
      if (!((key SUBSEP $1) in acct)) { acct[key SUBSEP $1]=1; nacct[key]++ }
      if (!((key SUBSEP $2) in reg))  { reg[key SUBSEP $2]=1; regs[key]=regs[key] (regs[key]==""?"":" ") $2 }
    }
    END { for (i=1;i<=n;i++) printf "%s\t%d\t%s\n", order[i], nacct[order[i]], regs[order[i]] }' \
  | while IFS=$'\t' read -r cmd n regs; do
      local why; why=$(explain_cmd "$cmd")
      printf '\n  \033[2m# %s\033[0m\n' "${why:-$cmd}" >&2
      if [[ "$regs" == "-" ]]; then
        [[ "$n" -gt 1 ]] && printf '  \033[2m# ran once per account (%d)\033[0m\n' "$n" >&2
      else
        printf '  \033[2m# ran in %d account(s), region(s): %s\033[0m\n' "$n" "$regs" >&2
      fi
      printf '  %s\n' "$cmd" >&2
    done
  echo >&2
}
usage() { sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
urlencode() { jq -rn --arg s "$1" '$s|@uri'; }

# "https://Host.Example.com/path." -> "host.example.com"
normalize_name() { local n="$1"; n="${n#*://}"; n="${n%%/*}"; n="${n%%:*}"; n="${n%.}"; printf '%s' "$n" | tr 'A-Z' 'a-z'; }
# any element in common between two space-separated lists?
overlap() { local a b; for a in $1; do for b in $2; do [[ "$a" == "$b" ]] && return 0; done; done; return 1; }

# glob (case-insensitive, * ?) -> anchored regex for jq test($re;"i")
glob_to_re() {
  local g="$1" out="" c i
  [[ "$g" == *[\*\?]* ]] || g="*${g}*"
  for ((i=0; i<${#g}; i++)); do
    c="${g:i:1}"
    case "$c" in
      '*') out+='.*' ;;
      '?') out+='.' ;;
      '-'|'_'|' ') out+='[-_ ]?' ;;   # separators are optional: digital-asset ~ DigitalAsset ~ digital_asset
      '.'|'\\'|'^'|'$'|'+'|'('|')'|'{'|'}'|'|'|'['|']') out+="\\$c" ;;
      *)   out+="$c" ;;
    esac
  done
  printf '^%s$' "$out"
}

# ---------------------------------------------------------------------------
# Workers. Invoked as: $0 __scan <account_id> <account_name> <region>
# Credentials come from env; AWS_FIND_* carry the search terms. One JSON row per
# line on stdout, common keys: kind acct name region id label detail via.
# ---------------------------------------------------------------------------
emit() { jq -cn --arg acct "$W_ACCT" --arg name "$W_NAME" --arg region "$W_REGION" "$@"; }

ec2_instance_rows() {   # $1 = instance ids (space separated), $2 = via
  local ids="$1" via="$2"
  [[ -n "$ids" ]] || return 0
  # shellcheck disable=SC2086
  aws ec2 describe-instances --instance-ids $ids \
    --query 'Reservations[].Instances[].{id:InstanceId,state:State.Name,itype:InstanceType,label:(Tags[?Key==`Name`].Value|[0]),pub:PublicIpAddress,priv:PrivateIpAddress,az:Placement.AvailabilityZone}' \
    --output json | jq -c '.[]' \
  | while read -r i; do
      emit --argjson i "$i" --arg via "$via" \
        '{kind:"ec2",acct:$acct,name:$name,region:$region,via:$via,detail:($i.state+" "+$i.itype+" "+($i.pub//"-"))} + $i'
    done
}

scan_host() {
  local ips="${AWS_FIND_IPS:-}" cnames="${AWS_FIND_CNAMES:-}" host="$AWS_FIND_HOST" pat="${AWS_FIND_NAME:-}"
  local ipcsv="${ips// /,}"; ipcsv="${ipcsv%,}"

  if [[ -n "$ips" ]]; then
    # ENIs owning the IP: EC2, ELB nodes, NAT, RDS, Lambda... Description says which.
    for filter in "association.public-ip" "addresses.private-ip-address"; do
      aws ec2 describe-network-interfaces --filters "Name=${filter},Values=${ipcsv}" \
        --query 'NetworkInterfaces[].{id:NetworkInterfaceId,label:Description,type:InterfaceType,iid:Attachment.InstanceId,pub:Association.PublicIp,priv:PrivateIpAddress,vpc:VpcId}' \
        --output json | jq -c '.[]' \
      | while read -r eni; do
          local iid; iid=$(jq -r '.iid // empty' <<<"$eni")
          if [[ -n "$iid" ]]; then ec2_instance_rows "$iid" "eni:${filter}"
          else emit --argjson e "$eni" --arg via "eni:${filter}" \
                 '{kind:"eni",acct:$acct,name:$name,region:$region,via:$via,detail:($e.type+" "+($e.pub//"-"))} + $e'
          fi
        done
    done
    # Unattached Elastic IPs
    aws ec2 describe-addresses --filters "Name=public-ip,Values=${ipcsv}" \
      --query 'Addresses[].{pub:PublicIp,iid:InstanceId,eni:NetworkInterfaceId,id:AllocationId}' --output json \
    | jq -c '.[] | select(.iid == null)' \
    | while read -r a; do
        emit --argjson a "$a" '{kind:"eip",acct:$acct,name:$name,region:$region,via:"eip:unassociated",label:"Elastic IP (not attached)",detail:$a.pub} + $a'
      done
    # Lightsail by IP
    aws lightsail get-instances \
      --query 'instances[].{id:name,label:name,pub:publicIpAddress,priv:privateIpAddress,state:state.name,itype:bundleId,az:location.availabilityZone}' --output json 2>/dev/null \
    | jq -c --arg ips " ${ips} " '.[] | select(.pub != null and ($ips | contains(" " + .pub + " ")))' \
    | while read -r li; do
        emit --argjson l "$li" '{kind:"lightsail",acct:$acct,name:$name,region:$region,via:"lightsail:ip",detail:($l.state+" "+$l.itype+" "+$l.pub)} + $l'
      done
  fi

  # Tag / name pattern (any tag value) and Lightsail names
  if [[ -n "$pat" ]]; then
    local re; re=$(glob_to_re "$pat")
    aws ec2 describe-instances --filters "Name=tag-value,Values=*${pat}*" \
      --query 'Reservations[].Instances[].{id:InstanceId,state:State.Name,itype:InstanceType,label:(Tags[?Key==`Name`].Value|[0]),pub:PublicIpAddress,priv:PrivateIpAddress,az:Placement.AvailabilityZone,tags:Tags}' \
      --output json \
    | jq -c --arg re "$re" '.[] | .matched = ([.tags[]? | select(.Value | test($re;"i")) | "\(.Key)=\(.Value)"] | join(", ")) | del(.tags)' \
    | while read -r i; do
        emit --argjson i "$i" --arg via "tag:*${pat}*" \
          '{kind:"ec2",acct:$acct,name:$name,region:$region,via:($via+" ["+$i.matched+"]"),detail:($i.state+" "+$i.itype+" "+($i.pub//"-"))} + ($i|del(.matched))'
      done
    aws lightsail get-instances \
      --query 'instances[].{id:name,label:name,pub:publicIpAddress,priv:privateIpAddress,state:state.name,itype:bundleId,az:location.availabilityZone}' --output json 2>/dev/null \
    | jq -c --arg re "$re" '.[] | select(.label | test($re;"i"))' \
    | while read -r li; do
        emit --argjson l "$li" --arg via "lightsail-name:*${pat}*" '{kind:"lightsail",acct:$acct,name:$name,region:$region,via:$via,detail:($l.state+" "+$l.itype+" "+($l.pub//"-"))} + $l'
      done
  fi

  # CNAME -> load balancer -> target instances
  for cn in $cnames; do
    case "$cn" in *.elb.amazonaws.com|*.elb.*.amazonaws.com) ;; *) continue ;; esac
    aws elbv2 describe-load-balancers --query "LoadBalancers[?DNSName=='${cn}'].{arn:LoadBalancerArn,id:LoadBalancerName,type:Type}" --output json | jq -c '.[]' \
    | while read -r lb; do
        local arn; arn=$(jq -r .arn <<<"$lb")
        emit --argjson l "$lb" --arg via "elbv2:${cn}" '{kind:"elb",acct:$acct,name:$name,region:$region,via:$via,label:$l.id,detail:$l.type} + $l'
        local ids; ids=$(aws elbv2 describe-target-groups --load-balancer-arn "$arn" --query 'TargetGroups[].TargetGroupArn' --output text | tr '\t' '\n' \
          | while read -r tg; do [[ -n "$tg" ]] && aws elbv2 describe-target-health --target-group-arn "$tg" --query 'TargetHealthDescriptions[?starts_with(Target.Id, `i-`)].Target.Id' --output text; done | tr '\t\n' '  ')
        ec2_instance_rows "$ids" "elb:$(jq -r .id <<<"$lb")"
      done
    aws elb describe-load-balancers --query "LoadBalancerDescriptions[?DNSName=='${cn}'].{id:LoadBalancerName,instances:Instances[].InstanceId}" --output json | jq -c '.[]' \
    | while read -r lb; do
        emit --argjson l "$lb" --arg via "elb-classic:${cn}" '{kind:"elb",acct:$acct,name:$name,region:$region,via:$via,id:$l.id,label:$l.id,detail:"classic"}'
        ec2_instance_rows "$(jq -r '.instances|join(" ")' <<<"$lb")" "elb-classic:$(jq -r .id <<<"$lb")"
      done
  done

  # Route 53 is global: once per account
  if [[ "$W_REGION" == "$AWS_FIND_FIRST_REGION" ]]; then
    aws route53 list-hosted-zones --query 'HostedZones[].{zid:Id,zone:Name}' --output json \
    | jq -c --arg h "${host}." '.[] | select(.zone as $z | $h | endswith($z))' \
    | while read -r z; do
        aws route53 list-resource-record-sets --hosted-zone-id "$(jq -r .zid <<<"$z")" --start-record-name "$host" --max-items 3 \
          --query "ResourceRecordSets[?Name=='${host}.'].{rtype:Type,values:ResourceRecords[].Value,alias:AliasTarget.DNSName}" --output json | jq -c '.[]' \
        | while read -r rr; do
            emit --argjson r "$rr" --argjson z "$z" \
              '{kind:"route53",acct:$acct,name:$name,region:"global",via:("zone:"+$z.zone),id:$z.zid,label:($r.rtype+" -> "+(($r.alias // ($r.values|join(","))) // "?")),detail:$z.zone}'
          done
      done
  fi
}

scan_dns() {   # Route 53 is global: once per account
  [[ "$W_REGION" == "$AWS_FIND_FIRST_REGION" ]] || return 0
  local host="$AWS_FIND_HOST" apex="${AWS_FIND_APEX:-}" pubns="${AWS_FIND_PUBLIC_NS:-}"
  aws route53 list-hosted-zones --query 'HostedZones[].{zid:Id,zone:Name,private:Config.PrivateZone,records:ResourceRecordSetCount}' --output json \
  | jq -c --arg h "${host}." '.[] | select(.zone as $z | $h | endswith($z))' \
  | while read -r z; do
      local zid zone private status rec zns del q rr p candidates
      zid=$(jq -r .zid <<<"$z"); zone=$(jq -r .zone <<<"$z"); zone="${zone%.}"; private=$(jq -r .private <<<"$z")
      # --- is this zone what the internet actually uses for the name?
      if [[ "$private" == "true" ]]; then
        status="private zone: VPC-only, never authoritative on the internet"
      else
        zns=$(aws route53 get-hosted-zone --id "$zid" --query 'DelegationSet.NameServers' --output json | jq -r '.[] | ascii_downcase' | sort | xargs)
        if [[ -z "$apex" ]]; then
          status="public NS for the name could not be resolved; zone NS ${zns}"
        elif [[ "$zone" == "$apex" ]]; then
          if overlap "$zns" "$pubns"; then status="AUTHORITATIVE: public NS match this zone"
          else status="NOT LIVE: public NS (${pubns}) are not this zone's (${zns})"; fi
        elif [[ "$apex" == *".$zone" ]]; then
          del=$(aws route53 list-resource-record-sets --hosted-zone-id "$zid" --start-record-name "$apex" --start-record-type NS --max-items 1 \
                  --query "ResourceRecordSets[?Name=='${apex}.' && Type=='NS'].ResourceRecords[].Value" --output json | jq -r '.[] | ascii_downcase' | sed 's/\.$//' | sort | xargs)
          if [[ -n "$del" ]]; then status="parent zone: delegates ${apex} to ${del}"
          else status="parent zone: no NS delegation for ${apex} here, so the public ${apex} is served elsewhere"; fi
        else
          status="NOT DELEGATED: deeper than the public apex ${apex}, unreachable from the internet"
        fi
      fi
      # --- which record in this zone answers the name: exact, then wildcards walking up
      candidates="$host"; p="${host#*.}"
      while [[ "$p" == "$zone" || "$p" == *".$zone" ]]; do candidates+=" *.$p"; [[ "$p" == "$zone" ]] && break; p="${p#*.}"; done
      rec=""
      for q in $candidates; do
        rr=$(aws route53 list-resource-record-sets --hosted-zone-id "$zid" --start-record-name "$q" --max-items 5 \
               --query 'ResourceRecordSets[].{n:Name,t:Type,v:ResourceRecords[].Value,a:AliasTarget.DNSName}' --output json \
             | jq -r --arg q "${q}." '.[] | select((.n | gsub("\\\\052";"*")) == $q) | .t + " " + (if .a then "ALIAS " + .a else ((.v // [])|join(",")) end)' | tr '\n' ';')
        [[ -n "$rr" ]] && { rec="${q} → ${rr%;}"; break; }
      done
      [[ -n "$rec" ]] || rec="no record answers ${host} in this zone"
      emit --arg zid "$zid" --arg zone "$zone" --arg private "$private" --arg status "$status" --arg rec "$rec" \
        '{kind:"dns",acct:$acct,name:$name,region:"global",via:("zone:"+$zone),id:$zid,label:($zone + (if $private=="true" then " (private)" else "" end)),detail:($status + " · " + $rec),status:$status,record:$rec}'
    done
}

scan_s3() {   # buckets are account-global: list once, then find each bucket's region
  [[ "$W_REGION" == "$AWS_FIND_FIRST_REGION" ]] || return 0
  local re="$AWS_FIND_RE" want_tags="${AWS_FIND_S3_TAGS:-0}"
  bucket_region() {
    local loc; loc=$(aws s3api get-bucket-location --bucket "$1" --query LocationConstraint --output text 2>/dev/null || echo "?")
    case "$loc" in None|null|"") loc=us-east-1 ;; EU) loc=eu-west-1 ;; esac; echo "$loc"
  }
  aws s3api list-buckets --query 'Buckets[].{id:Name,created:CreationDate}' --output json | jq -c '.[]' \
  | while read -r b; do
      local bn loc via label matched
      bn=$(jq -r .id <<<"$b"); via=""; label="$bn"
      if jq -e --arg re "$re" '.id | test($re;"i")' <<<"$b" >/dev/null; then via="s3:name"; fi
      if [[ "$want_tags" == "1" ]]; then
        # CloudFormation/CDK tag buckets with aws:cloudformation:stack-name and
        # aws:cloudformation:logical-id, so a bucket known as "digital-asset"
        # is findable even when its physical name is a generated hash.
        loc=$(bucket_region "$bn")
        matched=$(aws s3api get-bucket-tagging --bucket "$bn" --region "$loc" --query 'TagSet' --output json 2>/dev/null \
          | jq -r --arg re "$re" '[.[]? | select(.Value | test($re;"i")) | "\(.Key)=\(.Value)"] | join(", ")' 2>/dev/null || true)
        if [[ -n "$matched" ]]; then via="${via:+$via+}tag [${matched}]"; fi
        label=$(aws s3api get-bucket-tagging --bucket "$bn" --region "$loc" --query 'TagSet[?Key==`aws:cloudformation:stack-name`].Value|[0]' --output text 2>/dev/null || true)
        [[ -z "$label" || "$label" == None ]] && label="$bn"
      fi
      [[ -n "$via" ]] || continue
      [[ -n "${loc:-}" ]] || loc=$(bucket_region "$bn")
      W_REGION="$loc" emit --argjson b "$b" --arg via "$via" --arg label "$label" \
        '{kind:"s3",acct:$acct,name:$name,region:$region,via:$via,label:$label,detail:("created "+($b.created|.[0:10]))} + $b'
      loc=""
    done
}

scan_sg() {
  aws ec2 describe-security-groups \
    --query 'SecurityGroups[].{id:GroupId,label:GroupName,desc:Description,vpc:VpcId,tags:Tags}' --output json \
  | jq -c --arg re "$AWS_FIND_RE" '.[] | select((.id|test($re;"i")) or (.label|test($re;"i")) or ((.desc//"")|test($re;"i")) or ((.tags//[])|any(.Value|test($re;"i"))))
        | .detail = ((.vpc//"-") + "  " + ((.desc//"")|.[0:48])) | del(.tags,.desc)' \
  | while read -r g; do
      emit --argjson g "$g" '{kind:"sg",acct:$acct,name:$name,region:$region,via:"ec2:describe-security-groups"} + $g'
    done
}

scan_pl() {
  aws ec2 describe-managed-prefix-lists \
    --query 'PrefixLists[].{id:PrefixListId,label:PrefixListName,owner:OwnerId,ver:Version,max:MaxEntries,fam:AddressFamily,tags:Tags}' --output json \
  | jq -c --arg re "$AWS_FIND_RE" '.[] | select((.id|test($re;"i")) or (.label|test($re;"i")) or ((.tags//[])|any(.Value|test($re;"i"))))
        | .detail = ("owner " + .owner + " v" + (.ver|tostring) + " max " + (.max|tostring) + " " + .fam) | del(.tags)' \
  | while read -r p; do
      emit --argjson p "$p" '{kind:"pl",acct:$acct,name:$name,region:$region,via:"ec2:describe-managed-prefix-lists"} + $p'
    done
}

scan_ec2() {
  aws ec2 describe-instances \
    --query 'Reservations[].Instances[].{id:InstanceId,state:State.Name,itype:InstanceType,label:(Tags[?Key==`Name`].Value|[0]),pub:PublicIpAddress,priv:PrivateIpAddress,az:Placement.AvailabilityZone,tags:Tags}' --output json \
  | jq -c --arg re "$AWS_FIND_RE" '.[] | select((.id|test($re;"i")) or ((.label//"")|test($re;"i")) or ((.pub//"")|test($re;"i")) or ((.priv//"")|test($re;"i")) or ((.tags//[])|any(.Value|test($re;"i"))))
        | .detail = (.state + " " + .itype + " " + (.pub // "-") + " " + (.priv // "-")) | del(.tags)' \
  | while read -r i; do
      emit --argjson i "$i" '{kind:"ec2",acct:$acct,name:$name,region:$region,via:"ec2:describe-instances"} + $i'
    done
}

scan_lambda() {
  aws lambda list-functions \
    --query 'Functions[].{id:FunctionName,label:FunctionName,runtime:Runtime,mem:MemorySize,mod:LastModified,arn:FunctionArn}' --output json \
  | jq -c --arg re "$AWS_FIND_RE" '.[] | select(.id | test($re;"i"))
        | .detail = ((.runtime//"-") + " " + (.mem|tostring) + "MB  modified " + (.mod|.[0:10]))' \
  | while read -r f; do
      emit --argjson f "$f" '{kind:"lambda",acct:$acct,name:$name,region:$region,via:"lambda:list-functions"} + $f'
    done
}

if [[ "${1:-}" == "__scan" ]]; then
  set +e +o pipefail            # one failing account/region must not abort the scan
  W_ACCT="$2"; W_NAME="$3"; W_REGION="$4"
  export AWS_DEFAULT_REGION="$W_REGION" AWS_PAGER=""
  case "$AWS_FIND_KIND" in
    host) scan_host ;; dns) scan_dns ;; ec2) scan_ec2 ;; s3) scan_s3 ;; sg) scan_sg ;; pl) scan_pl ;; lambda) scan_lambda ;;
  esac
  exit 0
fi

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --fast) MODE="fast"; shift ;;
    --json) JSON=1; shift ;;
    --show-commands) SHOW_CMDS=1; shift ;;
    --regions) REGIONS="$2"; shift 2 ;;
    --accounts) ACCOUNT_MODE="$2"; shift 2 ;;
    --role) ROLE_PREF="$2"; shift 2 ;;
    --parallel) PARALLEL="$2"; shift 2 ;;
    --name) NAME_PAT="$2"; shift 2 ;;
    --no-name) NAME_PAT="-"; shift ;;
    --tags) S3_TAGS=1; shift ;;
    --debug) DEBUG=1; TRACE="${TMPDIR:-/tmp}/aws-find.trace"; exec 9>"$TRACE"; BASH_XTRACEFD=9; set -x; shift ;;
    -h|--help) usage 0 ;;
    -v|--version) echo "aws-find ${VERSION}"; exit 0 ;;
    -*) die "unknown flag $1 (try --help)" ;;
    *) if [[ -z "$KIND" ]]; then KIND="$1"; elif [[ -z "$PATTERN" ]]; then PATTERN="$1"; else die "unexpected argument $1"; fi; shift ;;
  esac
done
case "$KIND" in host|dns|ec2|s3|sg|pl|lambda|roles) ;; "") usage 1 ;; *) die "unknown kind '$KIND' (host|dns|ec2|s3|sg|pl|lambda|roles)" ;; esac
[[ -n "$PATTERN" || "$KIND" == "roles" ]] || die "aws-find ${KIND} needs a $([[ $KIND == host || $KIND == dns ]] && echo dns-name || echo pattern) (try --help)"

need aws; need jq
HAVE_FZF=0; command -v fzf >/dev/null && HAVE_FZF=1
[[ $DEBUG -eq 1 ]] && log "Debug trace: ${TRACE}"

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
RESULTS="$TMP/results.jsonl"; : >"$RESULTS"
export AWS_FIND_KIND="$KIND" AWS_FIND_TMP="$TMP" AWS_FIND_FIRST_REGION="${REGIONS%% *}"
export AWS_FIND_SHOW_CMDS="$SHOW_CMDS" AWS_FIND_CMDLOG="$TMP/cmds-main.log"

# ---------------------------------------------------------------------------
# Search terms per kind
# ---------------------------------------------------------------------------
if [[ "$KIND" == "host" ]]; then
  need dig
  HOST=$(normalize_name "$PATTERN")
  log "Resolving ${HOST}"
  DIG_OUT=$(dig +short "$HOST" 2>/dev/null || true)
  CNAMES=$(grep -E '\.$' <<<"$DIG_OUT" | sed 's/\.$//' | xargs || true)
  IPS=$(grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' <<<"$DIG_OUT" | xargs || true)
  [[ -n "$IPS$CNAMES" ]] || die "could not resolve ${HOST}"
  [[ "$NAME_PAT" == "-" ]] && NAME_PAT="" || NAME_PAT="${NAME_PAT:-${HOST%%.*}}"
  [[ -n "$NAME_PAT" ]] && log "  Tag/name    : *${NAME_PAT}*"
  [[ -n "$CNAMES" ]]   && log "  CNAME chain : ${CNAMES}"
  [[ -n "$IPS" ]]      && log "  A records   : ${IPS}"
  for cn in $CNAMES; do case "$cn" in *.cloudfront.net) warn "  ${cn} is CloudFront; origin is not discoverable from DNS, relying on tag/name and Route 53." ;; esac; done
  # Classify each IP against Amazon's published ranges: tells us up front whether
  # it is AWS at all, which region, and which service. Cached for a day.
  IPR="${XDG_CACHE_HOME:-$HOME/.cache}/aws-find/ip-ranges.json"
  if [[ ! -s "$IPR" || -n "$(find "$IPR" -mtime +1 2>/dev/null)" ]]; then
    mkdir -p "$(dirname "$IPR")"; curl -sf --max-time 10 -o "$IPR" https://ip-ranges.amazonaws.com/ip-ranges.json || true
  fi
  if [[ -s "$IPR" ]]; then
    for ip in $IPS; do
      cls=$(python3 - "$IPR" "$ip" <<'PYX' 2>/dev/null
import json, sys, ipaddress
d=json.load(open(sys.argv[1])); a=ipaddress.ip_address(sys.argv[2]); regs=set(); svcs=set()
for p in d['prefixes']:
    if a in ipaddress.ip_network(p['ip_prefix']): regs.add(p['region']); svcs.add(p['service'])
svcs.discard('AMAZON')
print(" ".join(sorted(regs)) + "|" + ",".join(sorted(svcs)) if regs else "")
PYX
) || cls=""
      if [[ -z "$cls" ]]; then
        warn "  ${ip} is NOT in Amazon's published IP ranges: this host is probably not on AWS."
      else
        ipreg="${cls%%|*}"; ipsvc="${cls#*|}"
        log "  ${ip} is AWS ${ipsvc:-?} in region ${ipreg}"
        for r in $ipreg; do
          [[ "$r" == GLOBAL ]] && continue
          [[ " $REGIONS " == *" $r "* ]] || { REGIONS="$REGIONS $r"; warn "  region ${r} was not in the scan list; adding it"; }
        done
      fi
    done
  fi
  export AWS_FIND_HOST="$HOST" AWS_FIND_NAME="$NAME_PAT" AWS_FIND_IPS="$IPS" AWS_FIND_CNAMES="$CNAMES"
elif [[ "$KIND" == "dns" ]]; then
  need dig
  HOST=$(normalize_name "$PATTERN")
  log "Public DNS view of ${HOST}"
  ANS=$(dig +short "$HOST" 2>/dev/null | sed 's/\.$//' | xargs || true)
  [[ -n "$ANS" ]] && log "  resolves to : ${ANS}" || warn "  does not resolve publicly"
  # The public zone apex is the longest suffix that has NS records; a delegated
  # child zone (cus-1.example.app) shows up here as its own apex.
  APEX=""; PUBNS=""; n="$HOST"
  while [[ "$n" == *.* ]]; do
    ns=$(dig +short NS "$n" 2>/dev/null | sed 's/\.$//' | tr 'A-Z' 'a-z' | sort | xargs || true)
    [[ -n "$ns" ]] && { APEX="$n"; PUBNS="$ns"; break; }
    n="${n#*.}"
  done
  if [[ -z "$APEX" ]]; then
    warn "  no NS records found for any suffix of ${HOST}; cannot tell which zone is live"
  else
    log "  zone apex   : ${APEX}"
    log "  public NS   : ${PUBNS}"
    case "$PUBNS" in
      *awsdns*)          log "  provider    : Route 53 (a matching hosted zone below will be marked AUTHORITATIVE)" ;;
      *cloudflare*)      warn "  provider    : Cloudflare, not Route 53; any hosted zone found below is not live" ;;
      *)                 warn "  provider    : not Route 53 (${PUBNS%% *} ...); any hosted zone found below is not live" ;;
    esac
  fi
  export AWS_FIND_HOST="$HOST" AWS_FIND_APEX="$APEX" AWS_FIND_PUBLIC_NS="$PUBNS"
elif [[ "$KIND" == "roles" ]]; then
  :
else
  [[ "$MODE" == "fast" ]] && die "--fast is only available for 'host'"
  RE=$(glob_to_re "$PATTERN")
  log "Searching ${KIND} matching ${PATTERN}  (regex ${RE}, case-insensitive)"
  export AWS_FIND_RE="$RE" AWS_FIND_S3_TAGS="$S3_TAGS"
  [[ "$S3_TAGS" -eq 1 && "$KIND" != "s3" ]] && warn "--tags only affects 's3' (sg, pl and host already match tags)"
  [[ "$S3_TAGS" -eq 1 ]] && log "  also matching bucket tags (stack name, logical id, custom tags); slower"
fi

# ---------------------------------------------------------------------------
# FAST path (host only): org-wide Config aggregator in the Audit account
# ---------------------------------------------------------------------------
if [[ "$MODE" == "fast" ]]; then
  [[ -n "$AGG_PROFILE" ]] || die "--fast needs AWS_FIND_AGG_PROFILE (a profile with config:SelectAggregateResourceConfig in the aggregator account)"
  inlist=""; for ip in $IPS; do inlist+="'${ip}',"; done; inlist="${inlist%,}"
  [[ -n "$inlist" ]] || die "--fast needs at least one A record"
  log "Querying Config aggregator ${AGG_NAME} via profile ${AGG_PROFILE}"
  AWS_PROFILE="$AGG_PROFILE" aws configservice select-aggregate-resource-config \
    --configuration-aggregator-name "$AGG_NAME" \
    --expression "SELECT accountId, awsRegion, resourceId, resourceName, configuration.publicIp, configuration.privateIp, configuration.state.name, configuration.instanceType WHERE resourceType = 'AWS::EC2::Instance' AND (configuration.publicIp IN (${inlist}) OR configuration.privateIp IN (${inlist}))" \
    --output json \
  | jq -c '.Results[] | fromjson | {kind:"ec2",acct:.accountId,name:"",region:.awsRegion,via:"config-aggregator",id:.resourceId,label:.resourceName,state:.configuration.state.name,itype:.configuration.instanceType,pub:.configuration.publicIp,priv:.configuration.privateIp,detail:(.configuration.state.name+" "+.configuration.instanceType+" "+(.configuration.publicIp//"-"))}' \
  >>"$RESULTS" || warn "aggregator query failed; falling back to fan-out"
  [[ -s "$RESULTS" ]] || MODE="fanout"
fi

# ---------------------------------------------------------------------------
# FAN-OUT: enumerate Identity Center accounts, mint creds, scan in parallel
# ---------------------------------------------------------------------------
if [[ "$MODE" == "fanout" ]]; then
  need xargs
  if [[ -z "$SSO_SESSION" ]]; then
    mapfile -t sessions < <(awk '/^\[sso-session /{sub(/^\[sso-session /,""); sub(/\]$/,""); print}' ~/.aws/config 2>/dev/null)
    case "${#sessions[@]}" in
      0) die "no [sso-session ...] block in ~/.aws/config; run 'aws configure sso-session' first" ;;
      1) SSO_SESSION="${sessions[0]}" ;;
      *) die "several sso-sessions in ~/.aws/config (${sessions[*]}); set AWS_FIND_SSO_SESSION to pick one" ;;
    esac
  fi
  START_URL=$(awk -v s="[sso-session ${SSO_SESSION}]" '$0==s{f=1;next} /^\[/{f=0} f&&/sso_start_url/{print $3}' ~/.aws/config)
  SSO_REGION=$(awk -v s="[sso-session ${SSO_SESSION}]" '$0==s{f=1;next} /^\[/{f=0} f&&/sso_region/{print $3}' ~/.aws/config)
  [[ -n "$START_URL" && -n "$SSO_REGION" ]] || die "sso-session '${SSO_SESSION}' not found in ~/.aws/config"

  sso_token() {
    local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    for f in ~/.aws/sso/cache/*.json; do
      jq -r --arg u "$START_URL" --arg now "$now" 'select(.startUrl==$u and .accessToken!=null and .expiresAt > $now) | .accessToken' "$f" 2>/dev/null
    done | head -n1
  }
  TOKEN=$(sso_token)
  if [[ -z "$TOKEN" ]]; then
    log "No valid SSO token; launching browser login for sso-session ${SSO_SESSION}"
    aws sso login --sso-session "$SSO_SESSION" >&2
    TOKEN=$(sso_token); [[ -n "$TOKEN" ]] || die "SSO login did not yield a token"
  fi

  log "Listing accounts visible to you"
  aws sso list-accounts --region "$SSO_REGION" --access-token "$TOKEN" --output json \
    | jq -r '.accountList[] | "\(.accountId)\t\(.accountName)"' | sort -k2 >"$TMP/accounts.tsv"
  [[ -s "$TMP/accounts.tsv" ]] || die "no accounts returned by sso list-accounts"
  if [[ "$ACCOUNT_MODE" == "pick" && $HAVE_FZF -eq 1 ]]; then
    fzf --multi --header="TAB to select accounts to scan (ENTER = selection, none = all)" --with-nth=2.. --delimiter=$'\t' <"$TMP/accounts.tsv" >"$TMP/picked.tsv" || true
    [[ -s "$TMP/picked.tsv" ]] && mv "$TMP/picked.tsv" "$TMP/accounts.tsv"
  fi
  [[ "$KIND" == "roles" ]] || log "Scanning $(wc -l <"$TMP/accounts.tsv" | tr -d ' ') account(s) x regions [${REGIONS}] with ${PARALLEL} workers"

  : >"$TMP/jobs.tsv"; : >"$TMP/roles.tsv"
  while IFS=$'\t' read -r acct name; do
    CMD_CTX="$name"
    all_roles=$(aws sso list-account-roles --region "$SSO_REGION" --access-token "$TOKEN" --account-id "$acct" --query 'roleList[].roleName' --output json)
    role=$(jq -r --arg p "$ROLE_PREF" '
        def pick(n): map(select(.==n))[0];
        (if $p != "" then pick($p) else null end)
        // pick("AWSAdministratorAccess") // pick("AdministratorAccess")
        // pick("AWSPowerUserAccess")     // pick("PowerUserAccess")
        // pick("AWSReadOnlyAccess")      // pick("ReadOnlyAccess")
        // pick("ViewOnlyAccess")         // .[0] // empty' <<<"$all_roles")
    if [[ "$KIND" == "roles" ]]; then
      printf '%-38s %-13s %s\n' "$name" "$acct" "$(jq -r --arg r "$role" 'map(if .==$r then "\u001b[1;32m"+.+"\u001b[0m (will be used)" else . end) | join(", ")' <<<"$all_roles")"
      continue
    fi
    [[ -n "$role" ]] || { warn "  ${name} (${acct}): no role available, skipping"; continue; }
    [[ -n "$ROLE_PREF" && "$role" != "$ROLE_PREF" ]] && warn "  ${name} (${acct}): you do not hold ${ROLE_PREF}; using ${role}"
    aws sso get-role-credentials --region "$SSO_REGION" --access-token "$TOKEN" --account-id "$acct" --role-name "$role" --output json >"$TMP/cred-$acct.json" 2>/dev/null \
      || { warn "  ${name} (${acct}): could not assume ${role}, skipping"; continue; }
    printf '%s\t%s\t%s\n' "$acct" "$role" "$name" >>"$TMP/roles.tsv"
    for r in $REGIONS; do printf '%s\t%s\t%s\n' "$acct" "$name" "$r" >>"$TMP/jobs.tsv"; done
  done <"$TMP/accounts.tsv"; CMD_CTX=""
  [[ "$KIND" == "roles" ]] && { print_commands; exit 0; }

  # NUL-delimited so account names with spaces survive xargs.
  # shellcheck disable=SC2016
  tr '\n' '\0' <"$TMP/jobs.tsv" | xargs -0 -P "$PARALLEL" -n1 bash -c '
    IFS=$'"'"'\t'"'"' read -r acct name region <<<"$1"; c="$AWS_FIND_TMP/cred-$acct.json"
    export AWS_ACCESS_KEY_ID=$(jq -r .roleCredentials.accessKeyId "$c")
    export AWS_SECRET_ACCESS_KEY=$(jq -r .roleCredentials.secretAccessKey "$c")
    export AWS_SESSION_TOKEN=$(jq -r .roleCredentials.sessionToken "$c")
    printf "   %-36s %s\n" "$name" "$region" >&2
    export AWS_FIND_CMDLOG="$AWS_FIND_TMP/cmds-$acct-$region.log"
    "$0" __scan "$acct" "$name" "$region" 2>"$AWS_FIND_TMP/err-$acct-$region.log"
  ' "$0" >>"$RESULTS" || true

  ERRS=0
  for f in "$TMP"/err-*.log; do
    [[ -s "$f" ]] || continue
    ERRS=$((ERRS+1)); b=$(basename "$f" .log); b=${b#err-}; acct=${b%%-*}; region=${b#*-}
    aname=$(awk -F'\t' -v a="$acct" '$1==a{print $2}' "$TMP/accounts.tsv")
    arole=$(awk -F'\t' -v a="$acct" '$1==a{print $2}' "$TMP/roles.tsv"); aname="${aname} (as ${arole})"
    first=$(grep -m1 -E 'An error occurred|Error|error' "$f" | cut -c1-140 || head -n1 "$f" | cut -c1-140)
    [[ $DEBUG -eq 1 ]] && { warn "${aname} (${acct}) ${region}:"; sed 's/^/      /' "$f" >&2; } || warn "${aname} ${region}: ${first}"
  done
  [[ $ERRS -gt 0 ]] && warn "${ERRS} account/region scan(s) reported errors; hits in those may be missing. Run 'aws-find roles' to see which permission sets you hold, then retry with --role NAME (or --debug for full output)."
fi

# ---------------------------------------------------------------------------
# Present
# ---------------------------------------------------------------------------
[[ $SHOW_CMDS -eq 1 ]] && print_commands
[[ -s "$RESULTS" ]] || { warn "No ${KIND} matches for ${PATTERN} in the scanned accounts/regions."; exit 2; }
if [[ -f "$TMP/accounts.tsv" ]]; then
  jq -c --rawfile a "$TMP/accounts.tsv" '($a | split("\n") | map(select(length>0) | split("\t") | {(.[0]): .[1]}) | add) as $n
    | .name = (if .name=="" then ($n[.acct] // .acct) else .name end)' "$RESULTS" >"$TMP/r2"; mv "$TMP/r2" "$RESULTS"
fi
jq -s 'unique_by(.kind,.acct,.region,(.id // .via))[]' -c "$RESULTS" >"$TMP/r2"; mv "$TMP/r2" "$RESULTS"

if [[ $JSON -eq 1 ]]; then
  # add the console deep link and the role it uses, so other tools (television,
  # scripts) can act on a row without re-deriving anything
  while read -r row; do
    acct=$(jq -r .acct <<<"$row"); region=$(jq -r .region <<<"$row"); id=$(jq -r '.id // empty' <<<"$row"); rk=$(jq -r .kind <<<"$row")
    role=$(awk -F'\t' -v a="$acct" '$1==a{print $2}' "$TMP/roles.tsv" 2>/dev/null || true); role="${role:-${ROLE_PREF:-AdministratorAccess}}"
    [[ "$region" == "global" ]] && creg="${REGIONS%% *}" || creg="$region"
    jq -c --arg role "$role" --arg url "$(console_url "$acct" "$role" "$(console_dest "$rk" "$creg" "$id")")" '. + {role:$role, url:$url}' <<<"$row"
  done <"$RESULTS"
  exit 0
fi

echo >&2
jq -r 'select(.kind=="ec2" and .via=="ec2:describe-instances") | "\u001b[1;32m✔ \(.label // .id) (\(.id)) in account \(.name) [\(.acct)] region \(.region)  \(.detail)\u001b[0m"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="ec2" and .via!="ec2:describe-instances" and (.via|startswith("tag:")|not)) | "\u001b[1;32m✔ \(.label // .id) (\(.id)) is in account \(.name) [\(.acct)] region \(.region)  (IP match)\u001b[0m"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="ec2" and (.via|startswith("tag:"))) | "\u001b[1;36m~ \(.label // .id) (\(.id)) in account \(.name) [\(.acct)] region \(.region)  (name/tag match only: \(.via))\u001b[0m"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="lightsail") | "\u001b[1;32m✔ Lightsail \(.label) is in account \(.name) [\(.acct)] region \(.region)\u001b[0m"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="eip") | "\u001b[1;33m! \(.pub) is an unattached Elastic IP in account \(.name) [\(.acct)] region \(.region)\u001b[0m"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="dns") | (if (.status|startswith("AUTHORITATIVE")) then "\u001b[1;32m✔" elif (.status|startswith("parent zone: delegates")) then "\u001b[1;32m✔" else "\u001b[1;33m!" end) + " zone \(.label) in account \(.name) [\(.acct)] — \(.status)\u001b[0m\n    \(.record)"' "$RESULTS" >&2
jq -r 'select(.kind=="route53") | "  DNS record owned by account \(.name) [\(.acct)] (\(.via))"' "$RESULTS" | sort -u >&2
jq -r 'select(.kind=="s3" or .kind=="sg" or .kind=="pl" or .kind=="lambda") | "\u001b[1;32m✔ \(.kind) \(.label) in account \(.name) [\(.acct)] region \(.region)\u001b[0m"' "$RESULTS" | sort -u >&2
echo >&2
row_tsv() { jq -r '[.kind, .name, .acct, .region, (.id // "-"), (.label // "-"), (.detail // "-"), .via] | @tsv' "$RESULTS"; }
printf '\033[1m%s\033[0m\n' "$(row_tsv | column -t -s $'\t')" >&2; echo >&2

pick_row() {
  if [[ $HAVE_FZF -eq 1 ]]; then
    row_tsv | column -t -s $'\t' | nl -ba -w1 -s' ' | fzf --header="Select a ${KIND} hit for ${PATTERN}" --no-multi | awk '{print $1}'
  else echo 1; fi
}
IDX=$(pick_row) || true; [[ -n "$IDX" ]] || exit 0
ROW=$(sed -n "${IDX}p" "$RESULTS")
ACCT=$(jq -r .acct <<<"$ROW"); REGION=$(jq -r .region <<<"$ROW"); ID=$(jq -r '.id // empty' <<<"$ROW"); RKIND=$(jq -r .kind <<<"$ROW")
ROLE=$(awk -F'\t' -v a="$ACCT" '$1==a{print $2}' "$TMP/roles.tsv" 2>/dev/null || true); ROLE="${ROLE:-${ROLE_PREF:-AdministratorAccess}}"
[[ "$REGION" == "global" ]] && CREG="${REGIONS%% *}" || CREG="$REGION"

DEST=$(console_dest "$RKIND" "$CREG" "$ID")
CONSOLE_URL=$(console_url "$ACCT" "$ROLE" "$DEST")

[[ $DEBUG -eq 1 ]] && { set +x; log "Debug trace stopped before the action step so credentials never reach ${TRACE}"; }
ACTIONS=$'open console in browser\nprint console URL\nprint export lines for this account/role'
[[ "$RKIND" == "ec2" ]] && ACTIONS+=$'\nssm start-session to instance'
ACTIONS+=$'\nquit'
ACTION=$( { [[ $HAVE_FZF -eq 1 ]] && fzf --header="Action for ${ACCT} / ${REGION} / ${ID:-$RKIND}" <<<"$ACTIONS"; } || echo "quit" )
c="$TMP/cred-$ACCT.json"
case "$ACTION" in
  "open console in browser") (command -v open >/dev/null && open "$CONSOLE_URL") || (command -v xdg-open >/dev/null && xdg-open "$CONSOLE_URL") || echo "$CONSOLE_URL" ;;
  "print console URL") echo "$CONSOLE_URL" ;;
  "print export lines for this account/role")
    if [[ -f "$c" ]]; then
      jq -r '.roleCredentials | "export AWS_ACCESS_KEY_ID=\(.accessKeyId)\nexport AWS_SECRET_ACCESS_KEY=\(.secretAccessKey)\nexport AWS_SESSION_TOKEN=\(.sessionToken)"' "$c"; echo "export AWS_DEFAULT_REGION=${CREG}"
    else echo "aws sso login --sso-session ${SSO_SESSION}   # then assume ${ROLE} in ${ACCT}"; fi ;;
  "ssm start-session to instance")
    if [[ -f "$c" ]]; then
      AWS_ACCESS_KEY_ID=$(jq -r .roleCredentials.accessKeyId "$c") AWS_SECRET_ACCESS_KEY=$(jq -r .roleCredentials.secretAccessKey "$c") AWS_SESSION_TOKEN=$(jq -r .roleCredentials.sessionToken "$c") \
        aws ssm start-session --region "$CREG" --target "$ID"
    else echo "aws ssm start-session --region ${CREG} --target ${ID}"; fi ;;
  *) ;;
esac
