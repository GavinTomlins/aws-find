#!/usr/bin/env bash
# Regenerate assets/screenshot.svg from an offline run against tests/fake-aws,
# so the picture never contains real account data. Usage: assets/make-screenshot
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd); root=$(dirname "$here")
H=$(mktemp -d); trap 'rm -rf "$H"' EXIT
mkdir -p "$H/.aws/sso/cache" "$H/bin" "$H/.cache/aws-find"
printf '[sso-session acme]\nsso_start_url = https://acme.awsapps.com/start\nsso_region = ap-southeast-2\n' >"$H/.aws/config"
printf '{"startUrl":"https://acme.awsapps.com/start","accessToken":"tok","expiresAt":"2099-01-01T00:00:00Z"}' >"$H/.aws/sso/cache/a.json"
# a tiny fake ip-ranges.json so the classification line shows the normal path
printf '{"prefixes":[{"ip_prefix":"203.0.113.0/24","region":"ap-southeast-2","service":"EC2"}]}' >"$H/.cache/aws-find/ip-ranges.json"
cp "$root/tests/fake-aws" "$H/bin/aws"
printf '#!/usr/bin/env bash\necho 203.0.113.10\n' >"$H/bin/dig"
printf '#!/usr/bin/env bash\ncat >/dev/null; exit 130\n' >"$H/bin/fzf"
chmod +x "$H/bin/"*
{ printf '\033[1;32m$\033[0m aws-find host app.example.com\n'
  HOME=$H TMPDIR=$H PATH="$H/bin:$PATH" AWS_FIND_REGIONS="ap-southeast-2 us-east-1" AWS_FIND_PARALLEL=4 \
    "$root/aws-find" host app.example.com </dev/null 2>&1 | grep -v '^   ' || true
  printf '\033[1;32m$\033[0m aws-find s3 digital-asset --tags\n'
  HOME=$H TMPDIR=$H PATH="$H/bin:$PATH" AWS_FIND_REGIONS="ap-southeast-2" AWS_FIND_PARALLEL=4 \
    "$root/aws-find" s3 digital-asset --tags </dev/null 2>&1 | grep -v '^   \|Listing\|Scanning' || true
} >"$H/session.txt"
python3 - "$H/session.txt" "$here/screenshot.svg" <<'PY'
import re, sys, html
src, dst = sys.argv[1], sys.argv[2]
lines = open(src, encoding="utf-8").read().rstrip("\n").split("\n")
colors = {"30":"#5c6370","31":"#e06c75","32":"#98c379","33":"#e5c07b","34":"#61afef","35":"#c678dd","36":"#56b6c2","37":"#abb2bf"}
cw, lh, pad, top = 7.8, 19, 16, 40
width = int(pad*2 + cw*max(len(re.sub(r"\x1b\[[0-9;]*m","",l)) for l in lines))
height = int(top + lh*len(lines) + pad)
out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" font-family="SFMono-Regular,Menlo,Consolas,monospace" font-size="13">',
       f'<rect width="100%" height="100%" rx="8" fill="#282c34"/>',
       '<circle cx="20" cy="18" r="6" fill="#ff5f56"/><circle cx="40" cy="18" r="6" fill="#ffbd2e"/><circle cx="60" cy="18" r="6" fill="#27c93f"/>']
for i, line in enumerate(lines):
    y = top + lh*i + 13; x = pad; fill, bold = "#abb2bf", False
    out.append(f'<text y="{y}" xml:space="preserve">')
    for tok in re.split(r"(\x1b\[[0-9;]*m)", line):
        if tok.startswith("\x1b["):
            for code in tok[2:-1].split(";") or ["0"]:
                if code in ("", "0"): fill, bold = "#abb2bf", False
                elif code == "1": bold = True
                elif code in colors: fill = colors[code]
        elif tok:
            out.append(f'<tspan x="{x}" fill="{fill}"{" font-weight=\"bold\"" if bold else ""}>{html.escape(tok)}</tspan>')
            x += cw*len(tok)
    out.append('</text>')
out.append('</svg>')
open(dst, "w", encoding="utf-8").write("\n".join(out))
print(f"wrote {dst}: {len(lines)} lines, {width}x{height}")
PY
